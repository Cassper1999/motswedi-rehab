"use client";

import Link from "next/link";
import Image from "next/image";
import { motion } from "framer-motion";
import {
  BedDouble,
  UtensilsCrossed,
  Trophy,
  ArrowUpRight,
  HeartHandshake,
} from "lucide-react";
import CentreFacilitiesScrollBackground from "@/components/CentreFacilitiesScrollBackground";

const services = [
  {
    title: "Accommodation",
    icon: BedDouble,
    image:
      "/images/programmes/centre-facilities-and-services/accomodation.JPG",
    description:
      "Motswedi offers accommodation facilities for individuals, groups and organisations seeking convenient and affordable accommodation.",
    detail:
      "The facilities may be suitable for visitors, training participants, workshops, community programmes and other organised activities.",
    closing:
      "Book your accommodation with Motswedi and support a meaningful cause.",
  },
  {
    title: "Catering Services",
    icon: UtensilsCrossed,
    image: null,
    description:
      "Motswedi provides catering services for meetings, workshops, training programmes, events and other functions.",
    detail:
      "Our catering services offer convenient and affordable meal options while creating opportunities for skills development and income generation within the Centre.",
    closing:
      "Planning an event or meeting? Let Motswedi cater for you.",
  },
  {
    title: "Sports Facilities",
    icon: Trophy,
    image:
      "/images/programmes/centre-facilities-and-services/sportsfacilities.JPG",
    description:
      "Motswedi offers sports and recreational facilities that can be hired by schools, community groups, organisations and individuals for sporting activities, training, tournaments and recreational events.",
    detail:
      "The facilities provide an opportunity to promote active lifestyles, inclusion and community engagement while generating income to support the Centre's programmes.",
    closing:
      "Hire our sports facilities and help support rehabilitation and inclusion.",
  },
];

export default function CentreFacilitiesPage() {
  return (
    <main className="relative min-h-screen overflow-x-hidden bg-gradient-to-br from-[#f3efe6] via-[#e8f7ef] to-[#dff4ff] pb-16 pt-28 md:pt-36">
      <CentreFacilitiesScrollBackground />

      <section className="relative z-10 mx-auto max-w-7xl px-4 md:px-8">
        {/* HERO */}
        <motion.div
          initial={{ opacity: 0, y: 30 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.8 }}
          className="max-w-4xl"
        >
          <motion.h1 className="mt-3 text-4xl font-black leading-[1.05] md:text-6xl">
            <motion.span
              initial={{ opacity: 0, x: -60 }}
              animate={{ opacity: 1, x: 0 }}
              transition={{ duration: 0.8 }}
              className="block text-[#014d57]"
            >
              CENTRE
            </motion.span>

            <motion.span
              initial={{ opacity: 0, x: 60 }}
              animate={{ opacity: 1, x: 0 }}
              transition={{ delay: 0.25, duration: 0.8 }}
              className="block text-[#6aa93b]"
            >
              FACILITIES
            </motion.span>

            <motion.span
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ delay: 0.5, duration: 0.8 }}
              className="block text-[#014d57]"
            >
              AND SERVICES
            </motion.span>
          </motion.h1>

          <div className="mt-6 h-1 w-24 rounded-full bg-cyan-400" />

          <p className="mt-4 text-base leading-relaxed text-gray-600 md:mt-6 md:text-lg">
            Motswedi Rehabilitation Centre offers a range of services
            to individuals, organisations, schools, community groups
            and other clients. Revenue generated from these services
            contributes towards supporting the Centre&apos;s
            rehabilitation programmes, skills development and
            services for children and youth with disabilities.
          </p>
        </motion.div>

        {/* WHAT WE OFFER */}
        <motion.div
          initial={{ opacity: 0, y: 40 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true, amount: 0.3 }}
          transition={{ duration: 0.7 }}
          className="mt-8 rounded-[1.5rem] bg-white/90 p-6 shadow-xl backdrop-blur-md md:mt-12 md:rounded-[2rem] md:p-10"
        >
          <p className="text-xs font-bold uppercase tracking-[0.2em] text-[#6aa93b]">
            What We Offer
          </p>

          <h2 className="mt-3 text-2xl font-bold text-[#014d57] md:text-3xl">
            Facilities and Services
          </h2>

          <p className="mt-4 text-base leading-relaxed text-gray-600 md:mt-6 md:text-lg">
            Discover the facilities and services available at
            Motswedi Rehabilitation Centre.
          </p>
        </motion.div>

        {/* SERVICES */}
        <div className="mt-8 space-y-8 md:mt-12 md:space-y-12">
          {services.map((service, index) => {
            const Icon = service.icon;

            return (
              <motion.article
                key={service.title}
                initial={{ opacity: 0, y: 40 }}
                whileInView={{ opacity: 1, y: 0 }}
                viewport={{ once: true, amount: 0.2 }}
                transition={{
                  duration: 0.7,
                  delay: index * 0.08,
                }}
                className="overflow-hidden rounded-[1.5rem] border border-white/70 bg-white/90 shadow-xl backdrop-blur-md md:rounded-[2rem]"
              >
                <div className="grid md:grid-cols-[0.9fr_1.1fr]">
                  {/* LEFT TILE AREA */}
                  <div className="relative min-h-[320px] overflow-hidden md:min-h-[420px]">
                    {service.image ? (
                      <>
                        <Image
                          src={service.image}
                          alt={service.title}
                          fill
                          className="object-cover"
                        />
                        <div className="absolute inset-0 bg-gradient-to-t from-[#014d57]/92 via-[#014d57]/55 to-[#014d57]/20" />
                      </>
                    ) : (
                      <div className="absolute inset-0 bg-gradient-to-br from-[#014d57] via-[#01616d] to-[#028090]" />
                    )}

                    <div className="absolute left-0 top-0 h-1.5 w-full bg-gradient-to-r from-[#6aa93b] via-cyan-400 to-white" />

                    <div className="relative z-10 flex h-full flex-col justify-between p-8 text-white md:p-12">
                      <div className="flex items-start justify-between gap-4">
                        <div className="flex h-16 w-16 items-center justify-center rounded-2xl border border-white/20 bg-white/10 backdrop-blur-sm">
                          <Icon
                            size={32}
                            strokeWidth={1.5}
                            className="text-white"
                          />
                        </div>

                        <span className="text-sm font-bold tracking-[0.2em] text-white/70">
                          0{index + 1}
                        </span>
                      </div>

                      <div className="mt-16 md:mt-24">
                        <p className="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-cyan-200">
                          Motswedi Rehabilitation Centre
                        </p>

                        <h2 className="text-3xl font-black leading-tight md:text-4xl">
                          {service.title}
                        </h2>
                      </div>
                    </div>
                  </div>

                  {/* RIGHT CONTENT */}
                  <div className="flex flex-col justify-center p-6 md:p-10 lg:p-12">
                    <h3 className="text-2xl font-bold text-[#014d57] md:text-3xl">
                      {service.title}
                    </h3>

                    <p className="mt-4 text-base leading-relaxed text-gray-600 md:text-lg">
                      {service.description}
                    </p>

                    <p className="mt-4 text-base leading-relaxed text-gray-600 md:text-lg">
                      {service.detail}
                    </p>

                    <div className="mt-6 rounded-2xl border border-[#6aa93b]/20 bg-[#eef8e9] p-5">
                      <p className="text-base font-semibold leading-relaxed text-[#014d57]">
                        {service.closing}
                      </p>
                    </div>

                    <div className="mt-7">
                      <Link
                        href="/contact"
                        className="inline-flex items-center gap-3 rounded-2xl bg-[#6aa93b] px-6 py-3.5 text-sm font-bold text-white shadow-[0_12px_30px_rgba(106,169,59,0.22)] transition hover:-translate-y-1 hover:bg-[#5f9f34]"
                      >
                        Make an Enquiry
                        <ArrowUpRight size={18} />
                      </Link>
                    </div>
                  </div>
                </div>
              </motion.article>
            );
          })}
        </div>

        {/* SUPPORTING PURPOSE */}
        <motion.article
          initial={{ opacity: 0, y: 40 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true, amount: 0.2 }}
          transition={{ duration: 0.7 }}
          className="mt-8 rounded-[1.5rem] border border-white/70 bg-white/90 p-6 shadow-xl backdrop-blur-md md:mt-12 md:rounded-[2rem] md:p-10"
        >
          <div className="grid items-center gap-8 md:grid-cols-[auto_1fr]">
            <div className="flex h-20 w-20 items-center justify-center rounded-[1.5rem] bg-[#eef8e9] text-[#6aa93b]">
              <HeartHandshake size={40} strokeWidth={1.5} />
            </div>

            <div>
              <p className="text-xs font-bold uppercase tracking-[0.2em] text-[#6aa93b]">
                Beyond Every Service
              </p>

              <h2 className="mt-3 text-2xl font-black text-[#014d57] md:text-3xl">
                Supporting a Greater Purpose
              </h2>

              <p className="mt-4 text-base leading-relaxed text-gray-600 md:text-lg">
                By using Motswedi&apos;s income-generating services,
                clients are not only receiving quality services —
                they are also contributing to the sustainability
                of rehabilitation, education, skills development
                and community-based programmes.
              </p>

              <div className="mt-7 h-1 w-24 rounded-full bg-cyan-400" />

              <h3 className="mt-6 text-2xl font-black text-[#014d57] md:text-3xl">
                Book. Support.
                <span className="block text-[#6aa93b]">
                  Make a Difference.
                </span>
              </h3>
            </div>
          </div>
        </motion.article>

        {/* CONTACT */}
        <motion.section
          initial={{ opacity: 0, y: 40 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true, amount: 0.2 }}
          transition={{ duration: 0.7 }}
          className="mt-8 overflow-hidden rounded-[1.5rem] bg-gradient-to-br from-[#014d57] via-[#01616d] to-[#028090] p-8 text-white shadow-xl md:mt-12 md:rounded-[2rem] md:p-12"
        >
          <div className="flex flex-col justify-between gap-8 md:flex-row md:items-center">
            <div>
              <p className="text-xs font-bold uppercase tracking-[0.2em] text-cyan-200">
                Get in Touch
              </p>

              <h2 className="mt-3 text-2xl font-black md:text-3xl">
                Interested in using our facilities?
              </h2>

              <p className="mt-4 max-w-xl text-base leading-relaxed text-white/80 md:text-lg">
                Contact Motswedi Rehabilitation Centre for enquiries
                about accommodation, catering and sports facilities.
              </p>
            </div>

            <Link
              href="/contact"
              className="inline-flex shrink-0 items-center justify-center gap-3 rounded-2xl bg-[#6aa93b] px-7 py-4 text-sm font-bold text-white shadow-lg transition hover:-translate-y-1 hover:bg-[#5f9f34]"
            >
              Contact Motswedi
              <ArrowUpRight size={18} />
            </Link>
          </div>
        </motion.section>
      </section>
    </main>
  );
}



